 // Prices are integer cents. A fraction of a cent rounds half up.
 
+// EX-4: no discount may take more than half the price.
+const MAX_DISCOUNT_PERCENT = 50;
+
 export function applyDiscount(cents, percent) {
-  return Math.round((cents * (100 - percent)) / 100);
+  const capped = Math.min(percent, MAX_DISCOUNT_PERCENT);
+  return Math.floor((cents * (100 - capped)) / 100);
 }
 
