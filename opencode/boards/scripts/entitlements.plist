<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The entitlements the darwin boards binaries are signed with under the
  hardened runtime (.github/workflows/boards-binaries.yml, sign-macos).
  A binary Bun compiles runs JavaScriptCore, whose JIT writes and
  runs machine code, so the hardened runtime must allow JIT and unsigned
  executable memory under a Developer ID signature. Bun's guide,
  https://bun.com/docs/guides/runtime/codesign-macos-executable, lists these
  two keys beside three more: disable-executable-page-protection, a weaker
  superset of the second, and allow-dyld-environment-variables and
  disable-library-validation, which matter only to a binary that loads
  native addons or dylibs, which this one does not.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
